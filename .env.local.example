# --- Telegram-уведомления (обязательно для формы заявок) ---
# Токен бота: создаётся через @BotFather в Telegram (команда /newbot)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceWithRealOne

# ID чата/канала, куда будут приходить заявки.
# Можно узнать через @userinfobot (для личного чата) либо добавив бота в группу
# и открыв https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# --- Публичные параметры сайта ---
# Полный URL продакшн-сайта (без завершающего слэша), используется в SEO/OG/sitemap
NEXT_PUBLIC_SITE_URL=https://inforcechemical.ua

# Телефон, который показывается в шапке/футере/CTA
NEXT_PUBLIC_PHONE=0-800-33-10-80
NEXT_PUBLIC_PHONE_TEL=0800331080
